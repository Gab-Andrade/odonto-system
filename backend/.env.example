# Copie para .env e ajuste. Variáveis de ambiente têm prioridade sobre este arquivo.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://odonto_app:odonto_app@localhost:5432/odonto
MIGRATIONS_DATABASE_URL=postgresql+psycopg://odonto:odonto@localhost:5432/odonto
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]

# Arquivos (raio-X): "local" (pasta STORAGE_DIR) ou "s3" (AWS S3, Cloudflare R2, Backblaze...,
# com pip install -e ".[s3]"). Em produção prefira um bucket privado com criptografia.
STORAGE_BACKEND=local
STORAGE_DIR=var/arquivos
# S3_BUCKET=odonto-arquivos
# S3_REGION=sa-east-1
# S3_ENDPOINT_URL=          # só para R2/B2/MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Testes de integração (pytest) usam um banco separado:
# TEST_DATABASE_URL=postgresql+psycopg://odonto_app:odonto_app@localhost:5432/odonto_test
# TEST_MIGRATIONS_DATABASE_URL=postgresql+psycopg://odonto:odonto@localhost:5432/odonto_test
